{
  "name": "taskspipes-server",
  "version": "0.21.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functional": "vitest run -c vitest.functional.config.ts",
    "test:coverage": "vitest run --coverage && vitest run -c vitest.functional.config.ts --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "redis": "^6.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.2"
    }
  }
}
