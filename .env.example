# URL publique de TasksPipes (utilisée pour le callback OAuth et les liens depuis Outline)
APP_URL=http://localhost:3000
APP_PORT=3000

# Secret de chiffrement des sessions et des jetons Outline (>= 32 caractères)
# Générer avec : openssl rand -hex 32
APP_SECRET=change-me-change-me-change-me-change-me

POSTGRES_PASSWORD=change-me

# URL publique de votre instance Outline
OUTLINE_URL=https://outline.example.com
# Optionnel : URL interne utilisée par le serveur pour joindre l'API Outline
# OUTLINE_API_URL=http://outline:3000

# Connexion OAuth (recommandée) : créez une application dans Outline › Paramètres › Applications
# avec l'URL de redirection  ${APP_URL}/auth/outline/callback
OUTLINE_OAUTH_CLIENT_ID=
OUTLINE_OAUTH_CLIENT_SECRET=

# Connexion par clé API personnelle Outline (true/false)
ALLOW_API_KEY_LOGIN=true

# Autres serveurs Outline, choisis sur la page de connexion (connexion par clé API) : par défaut, tout serveur
# public en https. Pour les restreindre, liste de noms d'hôtes séparés par des virgules ("*.exemple.fr" accepté).
# OUTLINE_ALLOWED_HOSTS=
# Accepter aussi des serveurs en http ou sur une adresse interne (auto-hébergement sur le même réseau, tests).
# OUTLINE_ALLOW_PRIVATE=false

# Optionnel : n'accepter que les comptes d'un espace de travail Outline (team id) du serveur configuré
# OUTLINE_TEAM_ID=

LOG_LEVEL=info

# E-mails : invitations et liens de connexion des comptes invités par e-mail. Sans SMTP, rien n'est envoyé :
# une invitation affiche alors le lien de connexion, à transmettre soi-même.
SMTP_HOST=
SMTP_PORT=587
# true pour du TLS direct (port 465) ; sinon STARTTLS est utilisé s'il est proposé
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Expéditeur (SMTP_USER par défaut), par ex. "TasksPipes <taskspipes@example.com>"
MAIL_FROM=
