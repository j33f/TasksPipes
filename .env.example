# URL publique de TasksPipes (utilisée pour le callback OAuth et les liens depuis Outline)
APP_URL=http://localhost:3000
APP_PORT=3000

# Secret de chiffrement des sessions et des jetons Outline (>= 32 caractères)
# Générer avec : openssl rand -hex 32
APP_SECRET=change-me-change-me-change-me-change-me

POSTGRES_PASSWORD=change-me

# URL publique de votre instance Outline
OUTLINE_URL=https://outline.example.com
# Optionnel : URL interne utilisée par le serveur pour joindre l'API Outline
# OUTLINE_API_URL=http://outline:3000

# Connexion OAuth (recommandée) : créez une application dans Outline › Paramètres › Applications
# avec l'URL de redirection  ${APP_URL}/auth/outline/callback
OUTLINE_OAUTH_CLIENT_ID=
OUTLINE_OAUTH_CLIENT_SECRET=

# Connexion par clé API personnelle Outline (true/false)
ALLOW_API_KEY_LOGIN=true

# Optionnel : n'accepter que les comptes d'un espace de travail Outline (team id)
# OUTLINE_TEAM_ID=

LOG_LEVEL=info
