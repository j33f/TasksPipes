# Public URL of TasksPipes (used for the OAuth callback, links in e-mails and from Outline)
APP_URL=http://localhost:3000
APP_PORT=3000

# Secret encrypting sessions, Outline tokens and TOTP secrets (>= 32 characters)
# Generate one with: openssl rand -hex 32
APP_SECRET=change-me-change-me-change-me-change-me

POSTGRES_PASSWORD=change-me

# Public URL of your Outline instance
OUTLINE_URL=https://outline.example.com
# Optional: internal URL the server uses to reach the Outline API
# OUTLINE_API_URL=http://outline:3000

# OAuth sign-in (recommended): create an application in Outline › Settings › Applications
# with the redirect URL  ${APP_URL}/auth/outline/callback  (see OAUTH-OUTLINE.md)
OUTLINE_OAUTH_CLIENT_ID=
OUTLINE_OAUTH_CLIENT_SECRET=

# Sign-in with a personal Outline API key (true/false)
ALLOW_API_KEY_LOGIN=true

# Other Outline servers, picked on the sign-in page (API key sign-in): by default any public https server.
# To restrict them, a comma-separated list of host names ("*.example.com" allowed).
# OUTLINE_ALLOWED_HOSTS=
# Also accept servers over http or on an internal address (self-hosting on the same network, tests).
# OUTLINE_ALLOW_PRIVATE=false

# Optional: only accept accounts of one workspace (team id) of the configured Outline server
# OUTLINE_TEAM_ID=

# Language when neither the profile nor the browser gives one (e-mails, people imported from Outline): en or fr
# DEFAULT_LOCALE=en

LOG_LEVEL=info

# E-mails: invitations and sign-in links of accounts invited by e-mail. Without SMTP nothing is sent:
# an invitation then shows the sign-in link, for the inviter to pass on.
SMTP_HOST=
SMTP_PORT=587
# true for direct TLS (port 465); otherwise STARTTLS is used when offered
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender (defaults to SMTP_USER), e.g. "TasksPipes <taskspipes@example.com>"
MAIL_FROM=
