# E-mail, Outline and sign-in settings can also be managed in the app (Administration › Settings). A variable set
# here (not empty) wins and shows locked there: leave those you want to manage in the app empty or commented out.

# Public URL of TasksPipes (used for the OAuth callback, links in e-mails and from Outline)
APP_URL=http://localhost:3000
APP_PORT=3000
# Address the port is published on: 127.0.0.1 (default) lets only a reverse proxy on this machine reach
# the app. Use 0.0.0.0 only if the proxy runs on another machine, and firewall the port to it.
# APP_BIND=127.0.0.1

# Secret encrypting sessions, Outline tokens and TOTP secrets (>= 32 characters)
# Generate one with: openssl rand -hex 32
APP_SECRET=change-me-change-me-change-me-change-me

POSTGRES_PASSWORD=change-me

# Optional Outline server known to this instance, needed for OAuth sign-in. With OAuth set up, the sign-in page uses
# it without asking for a server; otherwise people type their Outline server there.
# OUTLINE_URL=https://outline.example.com
# Optional: internal URL the server uses to reach the Outline API
# OUTLINE_API_URL=http://outline:3000

# OAuth sign-in (recommended): create an application in Outline › Settings › Applications
# with the redirect URL  ${APP_URL}/auth/outline/callback  (see docs/HOSTING.md)
OUTLINE_OAUTH_CLIENT_ID=
OUTLINE_OAUTH_CLIENT_SECRET=

# Sign-in with a personal Outline API key (true/false)
# ALLOW_API_KEY_LOGIN=true

# Outline as a way to sign in and as a source of documents (true/false)
# OUTLINE_ENABLED=true

# Optional: company sign-in with an OpenID Connect provider (redirect URI: APP_URL/auth/oidc/callback)
# OIDC_ISSUER=https://sso.example.com/realms/acme
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Acme SSO
# OIDC_SCOPES=openid email profile
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_ENABLED=true

# Outline servers people may type on the sign-in page (API key sign-in): by default any public https server.
# To restrict them, a comma-separated list of host names ("*.example.com" allowed).
# OUTLINE_ALLOWED_HOSTS=
# Also accept servers over http or on an internal address (self-hosting on the same network, tests).
# OUTLINE_ALLOW_PRIVATE=false

# Outgoing webhooks may reach http and internal addresses (a receiver on the same network); off by default
# WEBHOOK_ALLOW_PRIVATE=false

# Push notifications (installable app): a key derived from APP_SECRET is used unless a pair is given.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Optional: only accept accounts of one workspace (team id) of the configured Outline server
# OUTLINE_TEAM_ID=

# Reports: time zone, and hour (0-23) at which daily reports (and weekly time reports on Fridays) are sent
# TIMEZONE=Europe/Paris
# REPORT_HOUR=18

# Language when neither the profile nor the browser gives one (e-mails, people imported from Outline): a file of locales/ (en, fr, es…)
# DEFAULT_LOCALE=en

LOG_LEVEL=info

# E-mails: invitations, sign-in links, reports and notifications. Without SMTP nothing is sent:
# an invitation then shows the sign-in link, for the inviter to pass on, and notifications are not offered.
SMTP_HOST=
# SMTP_PORT=587
# true for direct TLS (port 465); otherwise STARTTLS is used when offered
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender (defaults to SMTP_USER), e.g. "TasksPipes <taskspipes@example.com>"
MAIL_FROM=

# Rate limits: counters in Redis (set by docker-compose.yml to its Redis service), and how much longer a client is
# blocked at each new offence (2: one minute, then 2, 4…; 1: always one minute)
# REDIS_URL=redis://redis:6379
# RATE_LIMIT_BACKOFF_FACTOR=2

# Anyone can create an account with an e-mail address and a display name (needs SMTP)
# ALLOW_EMAIL_SIGNUP=true
# People can invite others by e-mail and send requests to connect
# ALLOW_EMAIL_INVITATIONS=true
# E-mail domains allowed to sign up or be invited (all when empty)
# EMAIL_DOMAINS=example.com

# Administrators of the instance (comma-separated): e-mail accounts, or Outline accounts of OUTLINE_URL, with these
# addresses. They see every account and can disable or enable it.
# ADMIN_EMAILS=admin@example.com
